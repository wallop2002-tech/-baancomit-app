{
  "name": "baancomit-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply baancomit-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply baancomit-db --remote",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "import": "tsx scripts/import.ts",
    "build:client": "esbuild src/client/import.ts --bundle --format=esm --minify --outfile=public/static/import.js"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "jose": "^6.2.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0",
    "xlsx": "^0.18.5"
  }
}
